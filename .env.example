# Supabase Authentication & Client Config
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AgriFlow Backend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Enable production Sentry error tracking integration
ENABLE_ERROR_TRACKING=false

# Sentry DSN for remote error capturing and performance telemetry
NEXT_PUBLIC_SENTRY_DSN=

# Application runtime mode (development, production, test)
NODE_ENV=development
